# Optional paths to compatible MediaPipe .task files.
# By default the browser downloads the versioned Google models.
# WASM is bundled from @mediapipe/tasks-vision. No Gemini API key is required.
# VITE_POSE_MODEL_URL=/models/pose_landmarker_full.task
# VITE_FACE_MODEL_URL=/models/face_landmarker.task
# VITE_MEDIAPIPE_WASM_URL=/mediapipe/wasm
